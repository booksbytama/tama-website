# App
# Include the scheme, e.g. https://booksbytama.com (the code tolerates a missing one)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project settings -> API keys)
NEXT_PUBLIC_SUPABASE_URL=
# Server-only "Secret key" (sb_secret_...). Bypasses RLS; never expose to the browser.
# The legacy service_role JWT also works here until Supabase retires it.
SUPABASE_SECRET_KEY=
# The browser never talks to Supabase directly, so no publishable/anon key is needed.
# Direct Postgres connection (Project settings -> Database -> Connection string, "Transaction" pooler is fine)
DATABASE_URL=

# Clerk (Dashboard -> API keys). Sign-in/up paths and post-auth redirects are set in code (app/layout.tsx).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard -> Webhooks -> endpoint {APP_URL}/api/webhooks/clerk (user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SECRET=

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Cloud Text-to-Speech (APIs & Services -> Credentials -> API key, restricted to the TTS API). Server-only.
GOOGLE_TTS_API_KEY=
